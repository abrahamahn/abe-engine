#version 450
// Writes a storage buffer and a write-only storage texture from a uniform block.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform Params { uint base; uint width; } params;
layout(set = 0, binding = 1) buffer Values { uint values[]; } values;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D image;
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    uint i = id.y * params.width + id.x;
    values.values[i] = params.base + i * 3u;
    imageStore(image, ivec2(id), vec4(float(id.x) / 255.0, float(id.y) / 255.0,
                                      float(id.x + id.y) / 255.0, 1.0));
}
