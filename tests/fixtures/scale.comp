#version 450
// Reads one storage buffer (read-only) and writes another.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Source { uint values[]; } source;
layout(set = 0, binding = 1) buffer Target { uint values[]; } target;
layout(push_constant) uniform Push { uint count; uint add; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        target.values[i] = source.values[i] * 2u + pc.add;
    }
}
